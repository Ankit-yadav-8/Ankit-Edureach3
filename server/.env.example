# ── Razorpay ──────────────────────────────────────────────
# Get these from Razorpay Dashboard → Settings → API Keys.
# The SECRET must stay on the server only — never put it in frontend code.
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_secret_here

# ── Cloudinary (community photo / video uploads) ──────────
# Cloudinary Dashboard → Settings → API Keys. The SECRET stays server-side;
# the browser uploads directly with a short-lived signature we generate.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── College Parichay AI chat assistant (Google Gemini) ────
# One Gemini key serves every chat mode; the /chat route auto-picks the mode from
# the question (exam/cutoff/admissions -> Google Search grounding; maths & coding
# -> a small thinking budget; else plain chat). Get a key at aistudio.google.com.
GEMINI_API_KEY=your_gemini_api_key
# Optional overrides (defaults shown):
# GEMINI_MODEL=gemini-2.5-flash             # main chat model (free tier; Pro needs billing)
# GEMINI_TITLE_MODEL=gemini-2.5-flash-lite  # cheap model: titles/follow-ups/memory/image prompts
# GEMINI_CHAT_THINKING_BUDGET=0             # 0 = no "thinking" (snappier replies)
# Image generation (text-to-image). Pollinations is keyless & free by default;
# point these at a paid provider's prompt-URL base + model to upgrade quality.
# IMAGE_API_BASE=https://image.pollinations.ai/prompt/
# IMAGE_MODEL=flux

# ── Email / OTP delivery (Brevo a.k.a. Sendinblue) ────────
# Login OTPs, parent reports and alerts are sent through Brevo's transactional
# API. WITHOUT BREVO_API_KEY the app runs in log-only mode (the code is printed
# to the server console and the /otp/send response includes devCode) — fine for
# local dev. Set the key to send real mail.
BREVO_API_KEY=your_brevo_api_key
# The "from" MUST be an address on a domain you've authenticated in Brevo
# (SPF/DKIM). Free webmail (gmail/yahoo/outlook/…) is rejected by DMARC and is
# auto-replaced with the verified domain sender.
SMTP_FROM_EMAIL=noreply@collegeparichay.in
SMTP_FROM_NAME=CollegeParichay
REPLY_TO_EMAIL=collegeparichay@gmail.com
# Optional: force log-only mode even when BREVO_API_KEY is set (e.g. staging).
# OTP_DEV_MODE=true

# ── Test PDF → CBT conversion (Groq) ──────────────────────
# A Groq key powers the test-paper converter (text LLM + page-image vision OCR).
GROQ_API_KEY=your_groq_api_key
# GROQ_MODEL=llama-3.3-70b-versatile   # text LLM for structuring the paper
# Math-heavy papers (JEE/NEET) are converted by reading the page IMAGES with a
# Groq vision model (text extraction loses the maths). Defaults are tuned for
# Groq's free tier (30k tokens/min) — a ~20-page paper takes ~2-3 min. On a paid
# tier, raise TEST_VISION_PAGES/_CONCURRENCY for much faster runs.
# GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# TEST_VISION=off            # disable vision conversion entirely
# TEST_VISION_SCALE=1.5      # page render scale (higher = sharper but more tokens)
# TEST_VISION_PAGES=1        # pages per request
# TEST_VISION_CONCURRENCY=1  # parallel requests (raise on a paid tier)
# TEST_VISION_MAXPAGES=50    # safety cap on pages read
# TEST_VISION_DIAGRAMS=on    # crop diagrams/figures from questions → Cloudinary (needs CLOUDINARY_*)
# TEST_PDF_STRIP=            # extra watermark strings to strip, comma-separated

# ── Other server config (already used by the app) ─────────
# MONGO_URI=...
# PORT=5000
#
# CLIENT_ORIGIN — comma-separated list of allowed browser origins for CORS.
# Production canonical host is the apex domain:
# CLIENT_ORIGIN=https://collegeparichay.in
#
# IMPORTANT: while migrating www -> apex (or vice-versa), allow BOTH so the
# live site never breaks depending on which host actually serves the page:
# CLIENT_ORIGIN=https://collegeparichay.in,https://www.collegeparichay.in
#
# (Leaving CLIENT_ORIGIN unset allows ALL origins — fine for local dev only.)
