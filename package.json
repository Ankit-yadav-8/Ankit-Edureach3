{
  "name": "edureach-portal",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "EduReach — JEE & College Discovery Portal (React + Vite)",
  "scripts": {
    "dev": "vite",
    "server": "cd server && node --watch index.js",
    "dev:full": "concurrently \"npm run dev\" \"npm run server\"",
    "sitemap": "node scripts/genSitemap.mjs",
    "neetblogs": "node scripts/genNeetBlogs.mjs",
    "prebuild": "node scripts/genSitemap.mjs",
    "build": "vite build",
    "prerender": "node scripts/prerender.mjs",
    "build:prod": "node scripts/genSitemap.mjs && vite build && node scripts/prerender.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "csv-parser": "^3.0.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "framer-motion": "^11.3.19",
    "katex": "^0.17.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.408.0",
    "mongoose": "^9.6.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@sparticuz/chromium": "^149.0.0",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^9.2.1",
    "gh-pages": "^6.3.0",
    "nodemon": "^3.1.14",
    "puppeteer": "^25.4.0",
    "puppeteer-core": "^25.3.0",
    "vite": "^8.0.14"
  },
  "main": "vite.config.js",
