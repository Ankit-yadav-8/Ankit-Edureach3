{
  "buildCommand": "npm run build:prod",
  "redirects": [
    {
      "source": "/jee-analysis",
      "destination": "/jee-main",
      "permanent": true
    },
    {
      "source": "/jee-2027-mentorship",
      "destination": "/mentorship/jee-2027",
      "permanent": true
    },
    {
      "source": "/jee-main-rank-predictor",
      "destination": "/jee-main",
      "permanent": true
    },
    {
      "source": "/jee-college-predictor",
      "destination": "/for-you",
      "permanent": true
    },
    {
      "source": "/iit-mentorship",
      "destination": "/mentorship/jee-2027",
      "permanent": true
    },
    {
      "source": "/neet-2027-mentorship",
      "destination": "/mentorship/neet",
      "permanent": true
    },
    {
      "source": "/college-comparison",
      "destination": "/compare",
      "permanent": true
    },
    {
      "source": "/josaa-cutoff",
      "destination": "/cutoffs",
      "permanent": true
    },
    {
      "source": "/neet-colleges/autonomous-state-edical-college-kushinagar",
      "destination": "/neet-colleges/autonomous-state-medical-college-kushinagar",
      "permanent": true
    },
    {
      "source": "/neet-colleges/autonomous-state-edical-college-akbarpur-kanpur",
      "destination": "/neet-colleges/autonomous-state-medical-college-akbarpur-kanpur",
      "permanent": true
    },
    {
      "source": "/neet-colleges/autonomous-state-edical-college-and-hospital-auraiya",
      "destination": "/neet-colleges/autonomous-state-medical-college-and-hospital-auraiya",
      "permanent": true
    },
    {
      "source": "/neet-colleges/autonomous-state-edical-college-and-hospital-gonda",
      "destination": "/neet-colleges/autonomous-state-medical-college-and-hospital-gonda",
      "permanent": true
    },
    {
      "source": "/neet-colleges/autonomous-state-edical-college-and-hospital-lakhimpuri-kheri",
      "destination": "/neet-colleges/autonomous-state-medical-college-and-hospital-lakhimpuri-kheri",
      "permanent": true
    },
    {
      "source": "/neet-colleges/autonomous-state-edical-college-and-hospital-kaushambi",
      "destination": "/neet-colleges/autonomous-state-medical-college-and-hospital-kaushambi",
      "permanent": true
    },
    {
      "source": "/neet-colleges/autonomous-state-edical-college-sonebhadra",
      "destination": "/neet-colleges/autonomous-state-medical-college-sonebhadra",
      "permanent": true
    },
    {
      "source": "/neet-colleges/kmc-medical-college-and-pradeshhospital-maharajganj-uttar-pradesh",
      "destination": "/neet-colleges/kmc-medical-college-and-hospital-maharajganj-uttar-pradesh",
      "permanent": true
    },
    {
      "source": "/neet-colleges/mahatma-vidur-pradesahutonomous-state-medical-college",
      "destination": "/neet-colleges/mahatma-vidur-autonomous-state-medical-college-bijnor",
      "permanent": true
    },
    {
      "source": "/neet-colleges/shri-gorakshnath-medical-pradeschollege-hospital-and-arogya-dham-gorakhpur-up",
      "destination": "/neet-colleges/shri-gorakshnath-medical-college-hospital-and-arogya-dham-gorakhpur-up",
      "permanent": true
    },
    {
      "source": "/neet-colleges/santiniketan-medical-colle-ge-bolpur-west-bengal",
      "destination": "/neet-colleges/santiniketan-medical-college-bolpur-west-bengal",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "X-Permitted-Cross-Domain-Policies",
          "value": "none"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests; script-src 'self' 'unsafe-inline' https://checkout.razorpay.com https://*.razorpay.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https:; frame-src 'self' https://*.razorpay.com https://checkout.razorpay.com https://api.razorpay.com; worker-src 'self' blob:; manifest-src 'self'; media-src 'self' data:; form-action 'self' https://*.razorpay.com"
        }
      ]
    }
  ]
}